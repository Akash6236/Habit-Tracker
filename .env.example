# Copy this file to `.env.local` and fill in your Supabase project credentials.
# Get these from: https://app.supabase.com → your project → Project Settings → API
#
# Both values are PUBLIC (safe to embed in the bundle). Real security is enforced
# by Supabase Row-Level Security policies — see SUPABASE_SETUP.md.
#
# Leave these BLANK if you just want to use the app locally with no cloud / no
# login. The app will fall back to local-only mode automatically.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
